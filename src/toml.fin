// SPDX-License-Identifier: MIT
// fin-toml v0.1.0 — a TOML (v1.0) parser and encoder for Fin.
//
// Parses: key/value pairs, dotted keys, [table] and [[array-of-tables]]
// headers, basic "..." (incl. multiline """...""") and literal '...'
// (incl. multiline '''...''') strings with escapes, integers (decimal,
// 0x/0o/0b, underscores, signs), floats (incl. inf/nan, exponents),
// booleans, datetimes (kept as raw text — Fin has no date type in std),
// arrays (nested, multiline, trailing commas, comments), and inline
// tables. Errors carry a line number and never abort: parsing returns a
// TomlResult with ok=false instead of blaming.
//
// Design decisions (see README.md):
// - Values are a tagged struct tree (TomlValue), mirroring finson's proven
//   JsonValue shape: heap-allocated nodes, parallel key/val collections
//   for tables, `&Collection<&TomlValue>` for arrays. A Collection of
//   struct values would need struct ==, which the backend refuses.
// - Duplicate keys are hard errors (TOML forbids redefinition). Tables
//   created by dotted keys or inline tables cannot be redefined by a
//   [header] later; implicit tables created as header-path intermediates
//   CAN be defined later. Tracked with TomlValue.flags bits.
// - Datetimes are kind 6 with the raw text in `s`: no silent loss of
//   the offset/fraction, and no fake date arithmetic.
// - The encoder emits canonical TOML: scalar keyvals first, then
//   sub-tables under [path] headers, arrays-of-tables under [[path]].
//   A parse -> encode round-trip preserves semantics (not formatting).

import { to_chars, from_chars, concat, substr, trim, len, equals, clone, free_str } from strings::std;
import { Collection } from collection::std;
import { number2str_float } from types::std;
import { read_to_string } from fs::std;

namespace fin {

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

// Value kinds are plain ints (finc 0.4.0 does not lower `const`
// declarations from an imported module, not even private ones):
// 0=string, 1=int, 2=float, 3=bool, 4=array, 5=table, 6=datetime.
// Use toml_kind_name() for a readable name.

#[export]
pub struct TomlValue {
    pub:
        kind <int>,
        s <string>,
        i <long>,
        f <double>,
        b <bool>,
        // Table-definition tracking bits:
        //   1 = defined by a [table] header (redefinition is an error)
        //   2 = created by a dotted key (a later [header] is an error)
        //   4 = inline table (cannot be extended from outside)
        flags <int>,
        // Array elements.
        items <&Collection<&TomlValue>>,
        // Table entries as parallel collections: keys[i] belongs to vals[i].
        keys <&Collection<string>>,
        vals <&Collection<&TomlValue>>,
}

#[export]
pub struct TomlError {
    pub:
        line <int>,
        message <string>,
}

#[export]
pub struct TomlResult {
    pub:
        ok <bool>,
        root <&TomlValue>,
        err <TomlError>,
}

// ---------------------------------------------------------------------------
// Constructors — every value is heap-allocated and owned by the caller.
// ---------------------------------------------------------------------------

#[export]
pub fun toml_str(s: string) <&TomlValue> {
    return new TomlValue{kind: 0, s: clone(s), i: cast<long>(0),
                         f: cast<double>(0), b: false, flags: 0,
                         items: null, keys: null, vals: null};
}

#[export]
pub fun toml_int(n: long) <&TomlValue> {
    return new TomlValue{kind: 1, s: null, i: n,
                         f: cast<double>(0), b: false, flags: 0,
                         items: null, keys: null, vals: null};
}

#[export]
pub fun toml_float(n: double) <&TomlValue> {
    return new TomlValue{kind: 2, s: null, i: cast<long>(0),
                         f: n, b: false, flags: 0,
                         items: null, keys: null, vals: null};
}

#[export]
pub fun toml_bool(b: bool) <&TomlValue> {
    return new TomlValue{kind: 3, s: null, i: cast<long>(0),
                         f: cast<double>(0), b: b, flags: 0,
                         items: null, keys: null, vals: null};
}

#[export]
pub fun toml_datetime(raw: string) <&TomlValue> {
    return new TomlValue{kind: 6, s: clone(raw), i: cast<long>(0),
                         f: cast<double>(0), b: false, flags: 0,
                         items: null, keys: null, vals: null};
}

#[export]
pub fun toml_array() <&TomlValue> {
    return new TomlValue{kind: 4, s: null, i: cast<long>(0),
                         f: cast<double>(0), b: false, flags: 0,
                         items: new Collection::<&TomlValue>{},
                         keys: null, vals: null};
}

#[export]
pub fun toml_table() <&TomlValue> {
    return new TomlValue{kind: 5, s: null, i: cast<long>(0),
                         f: cast<double>(0), b: false, flags: 0,
                         items: null,
                         keys: new Collection::<string>{},
                         vals: new Collection::<&TomlValue>{}};
}

#[export]
pub fun toml_kind_name(k: int) <string> {
    if (k == 0) { return "string"; }
    if (k == 1) { return "int"; }
    if (k == 2) { return "float"; }
    if (k == 3) { return "bool"; }
    if (k == 4) { return "array"; }
    if (k == 5) { return "table"; }
    if (k == 6) { return "datetime"; }
    return "unknown";
}

// ---------------------------------------------------------------------------
// Table access
// ---------------------------------------------------------------------------

#[export]
pub fun toml_table_get(t: &TomlValue, key: string) <&TomlValue> {
    if (t == null || t.kind != 5) { return null; }
    let n <int> = t.keys.len();
    for (let i <int> = 0; i < n; i++) {
        if (equals(t.keys.get(i), key)) { return t.vals.get(i); }
    }
    return null;
}

#[export]
pub fun toml_table_has(t: &TomlValue, key: string) <bool> {
    return toml_table_get(t, key) != null;
}

#[export]
pub fun toml_table_len(t: &TomlValue) <int> {
    if (t == null || t.kind != 5) { return 0; }
    return t.keys.len();
}

// Set key, replacing an existing entry. Caller owns `item`.
#[export]
pub fun toml_table_set(t: &TomlValue, key: string, item: &TomlValue) <noret> {
    if (t == null || t.kind != 5) { return; }
    let n <int> = t.keys.len();
    for (let i <int> = 0; i < n; i++) {
        if (equals(t.keys.get(i), key)) {
            toml_free(t.vals.get(i));
            t.vals.set(i, item);
            return;
        }
    }
    t.keys.push(clone(key));
    t.vals.push(item);
}

// Set key only if absent; returns false when the key already exists
// (the parser turns that into a duplicate-key error and frees `item`).
fun toml_table_set_new(t: &TomlValue, key: string, item: &TomlValue) <bool> {
    if (toml_table_get(t, key) != null) { return false; }
    t.keys.push(clone(key));
    t.vals.push(item);
    return true;
}

#[export]
pub fun toml_table_keys(t: &TomlValue) <&Collection<string>> {
    let out <&Collection<string>> = new Collection::<string>{};
    if (t == null || t.kind != 5) { return out; }
    let n <int> = t.keys.len();
    for (let i <int> = 0; i < n; i++) {
        out.push(clone(t.keys.get(i)));
    }
    return out;
}

#[export]
pub fun toml_array_len(v: &TomlValue) <int> {
    if (v == null || v.kind != 4) { return 0; }
    return v.items.len();
}

#[export]
pub fun toml_array_get(v: &TomlValue, i: int) <&TomlValue> {
    if (v == null || v.kind != 4) { return null; }
    if (i < 0 || i >= v.items.len()) { return null; }
    return v.items.get(i);
}

#[export]
pub fun toml_array_push(v: &TomlValue, item: &TomlValue) <noret> {
    if (v == null || v.kind != 4) { return; }
    v.items.push(item);
}

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

priv fun t_is_digit(c: char) <bool> {
    return c >= '0' && c <= '9';
}

priv fun t_is_alpha(c: char) <bool> {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

priv fun t_is_bare_key_char(c: char) <bool> {
    return t_is_alpha(c) || t_is_digit(c) || c == '_' || c == '-';
}

priv fun t_hex_val(c: char) <int> {
    if (c >= '0' && c <= '9') { return cast<int>(c) - cast<int>('0'); }
    if (c >= 'a' && c <= 'f') { return cast<int>(c) - cast<int>('a') + 10; }
    if (c >= 'A' && c <= 'F') { return cast<int>(c) - cast<int>('A') + 10; }
    return -1;
}

priv fun t_hex_digit(v: int) <char> {
    if (v < 10) { return cast<char>(cast<int>('0') + v); }
    return cast<char>(cast<int>('a') + v - 10);
}

// Slice [a, b) with clamping; never blames.
priv fun t_slice(s: string, a: int, b: int) <string> {
    let n <int> = len(s);
    let lo <int> = a;
    let hi <int> = b;
    if (lo < 0) { lo = 0; }
    if (hi > n) { hi = n; }
    if (hi < lo) { hi = lo; }
    if (lo > n) { return ""; }
    return substr(s, lo, hi - lo);
}

// Growable byte buffer (same shape as finson's JsonBuf, proven on finc).
struct TomlBuf {
    data <[char]>,
    len <int>,
    cap <int>,
}

fun toml_buf_new() <&TomlBuf> {
    let cap <int> = 64;
    return new TomlBuf{data: new [char, cap]{}, len: 0, cap: cap};
}

fun toml_buf_reserve(b: &TomlBuf, extra: int) <noret> {
    if (b.len + extra <= b.cap) { return; }
    let want <int> = b.cap * 2;
    while (want < b.len + extra) { want = want * 2; }
    let nd <[char]> = new [char, want]{};
    for (let i <int> = 0; i < b.len; i++) { nd[i] = b.data[i]; }
    delete b.data;
    b.data = nd;
    b.cap = want;
}

fun toml_buf_push(b: &TomlBuf, c: char) <noret> {
    toml_buf_reserve(b, 1);
    b.data[b.len] = c;
    b.len = b.len + 1;
}

fun toml_buf_append_str(b: &TomlBuf, s: string) <noret> {
    let m <int> = len(s);
    if (m == 0) { return; }
    toml_buf_reserve(b, m);
    let bytes <[char]> = to_chars(s);
    for (let i <int> = 0; i < m; i++) { b.data[b.len + i] = bytes[i]; }
    b.len = b.len + m;
    delete bytes;
}

fun toml_buf_to_string(b: &TomlBuf) <string> {
    return from_chars(b.data, 0, b.len);
}

fun toml_buf_free(b: &TomlBuf) <noret> {
    delete b.data;
    delete b;
}

// 64-bit int to decimal string (std's number2str truncates through %d,
// so TOML ints need their own conversion). Long-min is not representable
// by negation; it encodes as itself via the digit loop on the magnitude
// of -(v+1) plus one — handled by the caller-visible special case below.
priv fun toml_long_str(v: long) <string> {
    if (v == cast<long>(0)) { return "0"; }
    let neg <bool> = false;
    let mag <long> = v;
    if (v < cast<long>(0)) {
        neg = true;
        mag = cast<long>(0) - v;
        // Long-min negation wraps; detect it and fall back to the literal.
        if (mag < cast<long>(0)) { return "-9223372036854775808"; }
    }
    let out <string> = "";
    while (mag > cast<long>(0)) {
        let d <long> = mag % cast<long>(10);
        let ch <char> = cast<char>(cast<int>('0') + cast<int>(d));
        out = concat(t_char_str(ch), out);
        mag = mag / cast<long>(10);
    }
    if (neg) { out = concat("-", out); }
    return out;
}

// ---------------------------------------------------------------------------
// Parser state — errors are recorded on the struct (no exceptions in
// Fin); parse_* returns null on failure, mirroring finson.
// ---------------------------------------------------------------------------

struct TomlParser {
    text <[char]>,
    n <int>,
    pos <int>,
    line <int>,
    failed <bool>,
    err_line <int>,
    err_msg <string>,
}

fun toml_parser_fail(self: &TomlParser, msg: string) <noret> {
    if (!self.failed) {
        self.failed = true;
        self.err_line = self.line;
        self.err_msg = clone(msg);
    }
}

fun toml_parser_peek(self: &TomlParser) <char> {
    if (self.pos >= self.n) { return cast<char>(0); }
    return self.text[self.pos];
}

fun toml_parser_peek_at(self: &TomlParser, off: int) <char> {
    if (self.pos + off >= self.n) { return cast<char>(0); }
    return self.text[self.pos + off];
}

fun toml_parser_advance(self: &TomlParser) <char> {
    let c <char> = toml_parser_peek(self);
    if (self.pos < self.n) {
        self.pos = self.pos + 1;
        if (c == '\n') { self.line = self.line + 1; }
    }
    return c;
}

// Spaces and tabs only (inside a line).
fun toml_skip_inline_ws(self: &TomlParser) <noret> {
    while (self.pos < self.n) {
        let c <char> = self.text[self.pos];
        if (c == ' ' || c == '\t') {
            self.pos = self.pos + 1;
        } else {
            break;
        }
    }
}

// Whitespace, newlines, and #-comments (inside arrays).
fun toml_skip_ws_comments(self: &TomlParser) <noret> {
    while (self.pos < self.n) {
        let c <char> = self.text[self.pos];
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
            toml_parser_advance(self);
        } else if (c == '#') {
            while (self.pos < self.n && self.text[self.pos] != '\n') {
                self.pos = self.pos + 1;
            }
        } else {
            break;
        }
    }
}

// Expect end of line: optional inline ws, then a comment, newline, or EOF.
fun toml_expect_eol(self: &TomlParser) <bool> {
    toml_skip_inline_ws(self);
    let c <char> = toml_parser_peek(self);
    if (c == '#') {
        while (self.pos < self.n && self.text[self.pos] != '\n') {
            self.pos = self.pos + 1;
        }
        return true;
    }
    if (c == '\n' || c == cast<char>(0)) { return true; }
    toml_parser_fail(self, "unexpected trailing characters after value");
    return false;
}

// One-char string, freshly allocated.
priv fun t_char_str(c: char) <string> {
    let buf <[char]> = new [char, 2]{};
    buf[0] = c;
    let s <string> = from_chars(buf, 0, 1);
    delete buf;
    return s;
}

// ---------------------------------------------------------------------------
// Keys: bare [A-Za-z0-9_-]+ or quoted "..." / '...' segments, joined by
// '.' with optional whitespace around the dots.
// ---------------------------------------------------------------------------

// Parse one key segment; returns null on failure (error already recorded).
fun toml_parse_key_segment(self: &TomlParser) <string?> {
    let c <char> = toml_parser_peek(self);
    if (c == '"') {
        let s? <string> = toml_parse_basic_string(self);
        if (self.failed) { return null; }
        return s?;
    }
    if (c == '\'') {
        let s? <string> = toml_parse_literal_string(self);
        if (self.failed) { return null; }
        return s?;
    }
    if (!t_is_bare_key_char(c)) {
        toml_parser_fail(self, "expected a key");
        return null;
    }
    let start <int> = self.pos;
    while (self.pos < self.n && t_is_bare_key_char(self.text[self.pos])) {
        self.pos = self.pos + 1;
    }
    return from_chars(self.text, start, self.pos - start);
}

// Parse a full dotted key into segments. Returns null on failure.
fun toml_parse_key(self: &TomlParser) <&Collection<string>> {
    let keys <&Collection<string>> = new Collection::<string>{};
    toml_skip_inline_ws(self);
    let seg? <string> = toml_parse_key_segment(self);
    if (self.failed) { return null; }
    keys.push(seg?);
    while (true) {
        toml_skip_inline_ws(self);
        if (toml_parser_peek(self) != '.') { break; }
        toml_parser_advance(self);
        toml_skip_inline_ws(self);
        seg = toml_parse_key_segment(self);
        if (self.failed) { return null; }
        keys.push(seg?);
    }
    return keys;
}

// ---------------------------------------------------------------------------
// Strings
// ---------------------------------------------------------------------------

fun toml_parse_hex_escape(self: &TomlParser, digits: int) <int> {
    let acc <int> = 0;
    for (let i <int> = 0; i < digits; i++) {
        if (self.pos >= self.n) {
            toml_parser_fail(self, "truncated unicode escape");
            return 0;
        }
        let d <int> = t_hex_val(toml_parser_advance(self));
        if (d < 0) {
            toml_parser_fail(self, "invalid hex digit in unicode escape");
            return 0;
        }
        acc = acc * 16 + d;
    }
    return acc;
}

// Append one UTF-8 code point to the buffer.
fun toml_buf_push_utf8(b: &TomlBuf, cp: int) <noret> {
    if (cp < 128) {
        toml_buf_push(b, cast<char>(cp));
    } else if (cp < 2048) {
        toml_buf_push(b, cast<char>(192 + cp / 64));
        toml_buf_push(b, cast<char>(128 + cp % 64));
    } else if (cp < 65536) {
        toml_buf_push(b, cast<char>(224 + cp / 4096));
        toml_buf_push(b, cast<char>(128 + (cp / 64) % 64));
        toml_buf_push(b, cast<char>(128 + cp % 64));
    } else {
        toml_buf_push(b, cast<char>(240 + cp / 262144));
        toml_buf_push(b, cast<char>(128 + (cp / 4096) % 64));
        toml_buf_push(b, cast<char>(128 + (cp / 64) % 64));
        toml_buf_push(b, cast<char>(128 + cp % 64));
    }
}

// Basic string starting at the opening quote (already peeked as '"').
// Handles """multiline""" forms, escapes, and the line-ending-backslash
// continuation in multiline strings. Returns null on failure.
fun toml_parse_basic_string(self: &TomlParser) <string?> {
    let multiline <bool> = toml_parser_peek_at(self, 1) == '"'
        && toml_parser_peek_at(self, 2) == '"';
    toml_parser_advance(self);
    if (multiline) {
        toml_parser_advance(self);
        toml_parser_advance(self);
        // A newline immediately after the opening delimiter is trimmed.
        if (toml_parser_peek(self) == '\n') { toml_parser_advance(self); }
        else if (toml_parser_peek(self) == '\r'
            && toml_parser_peek_at(self, 1) == '\n') {
            toml_parser_advance(self);
            toml_parser_advance(self);
        }
    }
    let buf <&TomlBuf> = toml_buf_new();
    while (true) {
        if (self.pos >= self.n) {
            toml_parser_fail(self, "unterminated string");
            toml_buf_free(buf);
            return null;
        }
        // Peek first: consuming the newline would bump the line counter
        // before the error is recorded (error lines must point at the
        // string's line, not the next one).
        if (!multiline && toml_parser_peek(self) == '\n') {
            toml_parser_fail(self, "newline in single-line string");
            toml_buf_free(buf);
            return null;
        }
        let c <char> = toml_parser_advance(self);
        if (c == '"') {
            if (multiline) {
                // Closing """ — allow 1-2 quote chars of slack: the spec
                // permits up to two quotes inside a multiline string.
                if (toml_parser_peek(self) == '"'
                    && toml_parser_peek_at(self, 1) == '"') {
                    toml_parser_advance(self);
                    toml_parser_advance(self);
                    let s <string> = toml_buf_to_string(buf);
                    toml_buf_free(buf);
                    return s;
                }
                toml_buf_push(buf, '"');
            } else {
                let s <string> = toml_buf_to_string(buf);
                toml_buf_free(buf);
                return s;
            }
        } else if (c == '\\') {
            if (self.pos >= self.n) {
                toml_parser_fail(self, "unterminated escape");
                toml_buf_free(buf);
                return null;
            }
            let e <char> = toml_parser_advance(self);
            if (e == 'b') { toml_buf_push(buf, cast<char>(8)); }
            else if (e == 't') { toml_buf_push(buf, cast<char>(9)); }
            else if (e == 'n') { toml_buf_push(buf, cast<char>(10)); }
            else if (e == 'f') { toml_buf_push(buf, cast<char>(12)); }
            else if (e == 'r') { toml_buf_push(buf, cast<char>(13)); }
            else if (e == '"') { toml_buf_push(buf, '"'); }
            else if (e == '\\') { toml_buf_push(buf, '\\'); }
            else if (e == 'u') {
                let cp <int> = toml_parse_hex_escape(self, 4);
                if (self.failed) { toml_buf_free(buf); return null; }
                toml_buf_push_utf8(buf, cp);
            }
            else if (e == 'U') {
                let cp <int> = toml_parse_hex_escape(self, 8);
                if (self.failed) { toml_buf_free(buf); return null; }
                if (cp > 1114111) {
                    toml_parser_fail(self, "unicode escape out of range");
                    toml_buf_free(buf);
                    return null;
                }
                toml_buf_push_utf8(buf, cp);
            }
            else if (multiline && (e == '\n' || e == ' ' || e == '\t' || e == '\r')) {
                // Line-ending backslash: after the backslash, optional
                // spaces/tabs, then a newline, then all following
                // whitespace (including newlines) is skipped.
                let saw_nl <bool> = e == '\n' || e == '\r';
                if (e == '\r' && toml_parser_peek(self) == '\n') {
                    toml_parser_advance(self);
                }
                while (self.pos < self.n) {
                    let w <char> = self.text[self.pos];
                    if (w == ' ' || w == '\t') {
                        toml_parser_advance(self);
                    } else if (w == '\n' || w == '\r') {
                        saw_nl = true;
                        toml_parser_advance(self);
                        if (w == '\r' && toml_parser_peek(self) == '\n') {
                            toml_parser_advance(self);
                        }
                    } else {
                        break;
                    }
                }
                if (!saw_nl) {
                    toml_parser_fail(self, "line-ending backslash without a newline");
                    toml_buf_free(buf);
                    return null;
                }
                // Skip the remaining leading whitespace of the next line.
                while (self.pos < self.n) {
                    let w2 <char> = self.text[self.pos];
                    if (w2 == ' ' || w2 == '\t' || w2 == '\n' || w2 == '\r') {
                        toml_parser_advance(self);
                    } else {
                        break;
                    }
                }
            }
            else {
                toml_parser_fail(self, "invalid escape in string");
                toml_buf_free(buf);
                return null;
            }
        } else {
            toml_buf_push(buf, c);
        }
    }
    toml_buf_free(buf);
    return null;
}

// Literal string starting at the opening quote (already peeked as '\'').
fun toml_parse_literal_string(self: &TomlParser) <string?> {
    let multiline <bool> = toml_parser_peek_at(self, 1) == '\''
        && toml_parser_peek_at(self, 2) == '\'';
    toml_parser_advance(self);
    if (multiline) {
        toml_parser_advance(self);
        toml_parser_advance(self);
        if (toml_parser_peek(self) == '\n') { toml_parser_advance(self); }
        else if (toml_parser_peek(self) == '\r'
            && toml_parser_peek_at(self, 1) == '\n') {
            toml_parser_advance(self);
            toml_parser_advance(self);
        }
    }
    let buf <&TomlBuf> = toml_buf_new();
    while (true) {
        if (self.pos >= self.n) {
            toml_parser_fail(self, "unterminated string");
            toml_buf_free(buf);
            return null;
        }
        if (!multiline && toml_parser_peek(self) == '\n') {
            toml_parser_fail(self, "newline in single-line string");
            toml_buf_free(buf);
            return null;
        }
        let c <char> = toml_parser_advance(self);
        if (c == '\'') {
            if (multiline) {
                if (toml_parser_peek(self) == '\''
                    && toml_parser_peek_at(self, 1) == '\'') {
                    toml_parser_advance(self);
                    toml_parser_advance(self);
                    let s <string> = toml_buf_to_string(buf);
                    toml_buf_free(buf);
                    return s;
                }
                toml_buf_push(buf, '\'');
            } else {
                let s <string> = toml_buf_to_string(buf);
                toml_buf_free(buf);
                return s;
            }
        } else {
            toml_buf_push(buf, c);
        }
    }
    toml_buf_free(buf);
    return null;
}

// ---------------------------------------------------------------------------
// Dotted-key insertion and header navigation
// ---------------------------------------------------------------------------

// Insert `val` at dotted path `keys` inside table `t`.
// Intermediate tables are created (flagged "dotted", bit 2) and walked;
// the final segment must be absent. Returns false on duplicates,
// non-table segments, or attempts to extend an inline table.
fun toml_insert_dotted(t: &TomlValue, keys: &Collection<string>, val: &TomlValue) <bool> {
    let cur <&TomlValue> = t;
    let n <int> = keys.len();
    for (let i <int> = 0; i < n - 1; i++) {
        let seg <string> = keys.get(i);
        let next <&TomlValue> = toml_table_get(cur, seg);
        if (next == null) {
            next = toml_table();
            next.flags = 2; // created by a dotted key
            cur.keys.push(clone(seg));
            cur.vals.push(next);
        } else if (next.kind != 5) {
            return false;
        } else if (next.flags == 4) {
            return false; // cannot extend an inline table
        }
        cur = next;
    }
    let last <string> = keys.get(n - 1);
    if (toml_table_get(cur, last) != null) { return false; }
    cur.keys.push(clone(last));
    cur.vals.push(val);
    return true;
}

// Navigation for [header] paths: walk segments from the root, creating
// implicit tables as needed. An array segment descends into its LAST
// element (TOML's rule for [a.b] after [[a]]). Returns null on error.
fun toml_nav_header(root: &TomlValue, keys: &Collection<string>, upto: int) <&TomlValue> {
    let cur <&TomlValue> = root;
    for (let i <int> = 0; i < upto; i++) {
        let seg <string> = keys.get(i);
        let next <&TomlValue> = toml_table_get(cur, seg);
        if (next == null) {
            next = toml_table();
            cur.keys.push(clone(seg));
            cur.vals.push(next);
        } else if (next.kind == 4) {
            if (next.items.len() == 0) { return null; }
            next = next.items.get(next.items.len() - 1);
            if (next.kind != 5) { return null; }
        } else if (next.kind != 5) {
            return null;
        } else if (next.flags == 4) {
            return null; // cannot extend an inline table
        }
        cur = next;
    }
    return cur;
}

// ---------------------------------------------------------------------------
// Bare values: integers, floats, booleans, datetimes
// ---------------------------------------------------------------------------

// Read a bare token: up to whitespace, ',', ']', '}', '#', or newline.
fun toml_read_bare_token(self: &TomlParser) <string> {
    let start <int> = self.pos;
    while (self.pos < self.n) {
        let c <char> = self.text[self.pos];
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r'
            || c == ',' || c == ']' || c == '}' || c == '#') {
            break;
        }
        self.pos = self.pos + 1;
    }
    return from_chars(self.text, start, self.pos - start);
}

// TOML allows a space between the date and time parts
// ("1979-05-27 07:32:00"). The bare-token reader stops at that space,
// so extend a date-shaped token across spaces when a time follows.
// Never consumes input when the extension does not apply.
fun toml_extend_datetime(self: &TomlParser, tok: string) <string> {
    if (len(tok) != 10) { return tok; }
    let cs <[char]> = to_chars(tok);
    let is_date <bool> = t_is_digit(cs[0]) && t_is_digit(cs[1])
        && t_is_digit(cs[2]) && t_is_digit(cs[3]) && cs[4] == '-'
        && t_is_digit(cs[5]) && t_is_digit(cs[6]) && cs[7] == '-'
        && t_is_digit(cs[8]) && t_is_digit(cs[9]);
    delete cs;
    if (!is_date) { return tok; }
    let p <int> = self.pos;
    while (p < self.n && (self.text[p] == ' ' || self.text[p] == '\t')) {
        p = p + 1;
    }
    if (p + 8 > self.n) { return tok; }
    if (!t_is_digit(self.text[p]) || !t_is_digit(self.text[p + 1])
        || self.text[p + 2] != ':' || !t_is_digit(self.text[p + 3])
        || !t_is_digit(self.text[p + 4]) || self.text[p + 5] != ':'
        || !t_is_digit(self.text[p + 6]) || !t_is_digit(self.text[p + 7])) {
        return tok;
    }
    self.pos = p;
    let time_tok <string> = toml_read_bare_token(self);
    return concat(concat(tok, " "), time_tok);
}

// Underscore rules: no leading/trailing underscore, no "__".
fun toml_bad_underscores(s: string) <bool> {
    let n <int> = len(s);
    if (n == 0) { return true; }
    let cs <[char]> = to_chars(s);
    if (cs[0] == '_' || cs[n - 1] == '_') { delete cs; return true; }
    for (let i <int> = 0; i + 1 < n; i++) {
        if (cs[i] == '_' && cs[i + 1] == '_') { delete cs; return true; }
    }
    delete cs;
    return false;
}

// Strip underscores (validation already done by the caller).
fun toml_strip_underscores(s: string) <string> {
    let buf <&TomlBuf> = toml_buf_new();
    let cs <[char]> = to_chars(s);
    let n <int> = len(s);
    for (let i <int> = 0; i < n; i++) {
        if (cs[i] != '_') { toml_buf_push(buf, cs[i]); }
    }
    delete cs;
    let out <string> = toml_buf_to_string(buf);
    toml_buf_free(buf);
    return out;
}

// Digit test for a base (2, 8, 10, 16).
fun toml_digit_in_base(c: char, base: int) <int> {
    let d <int> = t_hex_val(c);
    if (d < 0 || d >= base) { return -1; }
    return d;
}

// Parse a validated integer token (sign, optional 0x/0o/0b, digits).
// Returns false on any shape violation.
fun toml_parse_int_token(tok: string, out: &TomlValue) <bool> {
    if (toml_bad_underscores(tok)) { return false; }
    let clean <string> = toml_strip_underscores(tok);
    let cs <[char]> = to_chars(clean);
    let n <int> = len(clean);
    let i <int> = 0;
    let neg <bool> = false;
    if (i < n && (cs[i] == '-' || cs[i] == '+')) {
        neg = cs[i] == '-';
        i = i + 1;
    }
    if (i >= n) { delete cs; return false; }
    let base <int> = 10;
    if (i + 1 < n && cs[i] == '0'
        && (cs[i + 1] == 'x' || cs[i + 1] == 'o' || cs[i + 1] == 'b')) {
        if (cs[i + 1] == 'x') { base = 16; }
        else if (cs[i + 1] == 'o') { base = 8; }
        else { base = 2; }
        i = i + 2;
        if (i >= n) { delete cs; return false; }
    } else if (base == 10 && n - i > 1 && cs[i] == '0') {
        // Leading zeros are not allowed in decimal integers.
        delete cs;
        return false;
    }
    let acc <long> = cast<long>(0);
    let ndigits <int> = 0;
    while (i < n) {
        let d <int> = toml_digit_in_base(cs[i], base);
        if (d < 0) { delete cs; return false; }
        acc = acc * cast<long>(base) + cast<long>(d);
        ndigits = ndigits + 1;
        i = i + 1;
    }
    delete cs;
    if (ndigits == 0) { return false; }
    if (neg) { acc = cast<long>(0) - acc; }
    out.kind = 1;
    out.i = acc;
    return true;
}

// Parse a validated float token (sign, digits, optional '.', exponent).
// Caller guarantees the token contains '.' or 'e'/'E', or is inf/nan.
fun toml_parse_float_token(tok: string, out: &TomlValue) <bool> {
    if (toml_bad_underscores(tok)) { return false; }
    let clean <string> = toml_strip_underscores(tok);
    let cs <[char]> = to_chars(clean);
    let n <int> = len(clean);
    let i <int> = 0;
    let neg <bool> = false;
    if (i < n && (cs[i] == '-' || cs[i] == '+')) {
        neg = cs[i] == '-';
        i = i + 1;
    }
    let val <double> = cast<double>(0);
    let ndigits <int> = 0;
    while (i < n && t_is_digit(cs[i])) {
        val = val * cast<double>(10)
            + cast<double>(cast<int>(cs[i]) - cast<int>('0'));
        ndigits = ndigits + 1;
        i = i + 1;
    }
    if (ndigits == 0) { delete cs; return false; }
    if (i < n && cs[i] == '.') {
        i = i + 1;
        let frac_digits <int> = 0;
        let place <double> = cast<double>(10);
        while (i < n && t_is_digit(cs[i])) {
            val = val + cast<double>(cast<int>(cs[i]) - cast<int>('0')) / place;
            place = place * cast<double>(10);
            frac_digits = frac_digits + 1;
            i = i + 1;
        }
        if (frac_digits == 0) { delete cs; return false; }
    }
    if (i < n && (cs[i] == 'e' || cs[i] == 'E')) {
        i = i + 1;
        let expneg <bool> = false;
        if (i < n && cs[i] == '-') { expneg = true; i = i + 1; }
        else if (i < n && cs[i] == '+') { i = i + 1; }
        let exp <int> = 0;
        let exp_digits <int> = 0;
        while (i < n && t_is_digit(cs[i])) {
            exp = exp * 10 + (cast<int>(cs[i]) - cast<int>('0'));
            exp_digits = exp_digits + 1;
            i = i + 1;
        }
        if (exp_digits == 0) { delete cs; return false; }
        let factor <double> = cast<double>(1);
        for (let k <int> = 0; k < exp; k++) {
            factor = factor * cast<double>(10);
        }
        if (expneg) { val = val / factor; } else { val = val * factor; }
    }
    delete cs;
    if (i != n) { return false; }
    if (neg) { val = cast<double>(0) - val; }
    out.kind = 2;
    out.f = val;
    return true;
}

// Loose-but-structural datetime check: YYYY-MM-DD, HH:MM:SS,
// YYYY-MM-DD[Tt ]HH:MM:SS[.frac][Zz|±HH:MM]. Deliberately does not
// validate month/day ranges — that is a calendar's job, not a parser's.
fun toml_is_datetime(tok: string) <bool> {
    let cs <[char]> = to_chars(tok);
    let n <int> = len(tok);
    let ok <bool> = false;
    if (n >= 10 && t_is_digit(cs[0]) && t_is_digit(cs[1])
        && t_is_digit(cs[2]) && t_is_digit(cs[3]) && cs[4] == '-'
        && t_is_digit(cs[5]) && t_is_digit(cs[6]) && cs[7] == '-'
        && t_is_digit(cs[8]) && t_is_digit(cs[9])) {
        if (n == 10) { ok = true; }
        else if (n > 10 && (cs[10] == 'T' || cs[10] == 't' || cs[10] == ' ')) {
            ok = toml_is_time_part(cs, n, 11);
        }
    } else if (n >= 8 && t_is_digit(cs[0]) && t_is_digit(cs[1])
        && cs[2] == ':' && t_is_digit(cs[3]) && t_is_digit(cs[4])
        && cs[5] == ':' && t_is_digit(cs[6]) && t_is_digit(cs[7])) {
        ok = toml_is_time_part(cs, n, 0);
    }
    delete cs;
    return ok;
}

// Time part at offset `o`: HH:MM:SS[.frac][Zz|±HH:MM]. `cs`/`n` are the
// token's chars; the caller already validated the HH:MM:SS prefix.
fun toml_is_time_part(cs: [char], n: int, o: int) <bool> {
    if (o + 8 > n) { return false; }
    if (!t_is_digit(cs[o]) || !t_is_digit(cs[o + 1]) || cs[o + 2] != ':'
        || !t_is_digit(cs[o + 3]) || !t_is_digit(cs[o + 4])
        || cs[o + 5] != ':' || !t_is_digit(cs[o + 6])
        || !t_is_digit(cs[o + 7])) {
        return false;
    }
    let i <int> = o + 8;
    if (i < n && cs[i] == '.') {
        i = i + 1;
        let fdigits <int> = 0;
        while (i < n && t_is_digit(cs[i])) { fdigits = fdigits + 1; i = i + 1; }
        if (fdigits == 0) { return false; }
    }
    if (i == n) { return true; }
    if (cs[i] == 'Z' || cs[i] == 'z') { return i + 1 == n; }
    if (cs[i] == '+' || cs[i] == '-') {
        if (i + 6 != n) { return false; }
        return t_is_digit(cs[i + 1]) && t_is_digit(cs[i + 2])
            && cs[i + 3] == ':' && t_is_digit(cs[i + 4])
            && t_is_digit(cs[i + 5]);
    }
    return false;
}

// Classify and parse a bare token into `out` (preallocated TomlValue).
// Returns false when the token is not a valid TOML value.
fun toml_parse_bare_token(tok: string, out: &TomlValue) <bool> {
    if (equals(tok, "true")) { out.kind = 3; out.b = true; return true; }
    if (equals(tok, "false")) { out.kind = 3; out.b = false; return true; }
    if (equals(tok, "inf") || equals(tok, "+inf")) {
        out.kind = 2;
        out.f = cast<double>(1) / cast<double>(0);
        return true;
    }
    if (equals(tok, "-inf")) {
        out.kind = 2;
        out.f = cast<double>(0) - cast<double>(1) / cast<double>(0);
        return true;
    }
    if (equals(tok, "nan") || equals(tok, "+nan") || equals(tok, "-nan")) {
        out.kind = 2;
        out.f = cast<double>(0) / cast<double>(0);
        return true;
    }
    if (toml_is_datetime(tok)) {
        out.kind = 6;
        out.s = clone(tok);
        return true;
    }
    // Base-prefixed integers must win over the float sniff below:
    // "0x1e5" contains an 'e' but is an integer.
    let cs <[char]> = to_chars(tok);
    let n <int> = len(tok);
    let j <int> = 0;
    if (j < n && (cs[j] == '-' || cs[j] == '+')) { j = j + 1; }
    let prefixed <bool> = j + 1 < n && cs[j] == '0'
        && (cs[j + 1] == 'x' || cs[j + 1] == 'o' || cs[j + 1] == 'b');
    delete cs;
    if (!prefixed) {
        let has_dot_or_exp <bool> = false;
        let cs2 <[char]> = to_chars(tok);
        for (let k <int> = 0; k < n; k++) {
            if (cs2[k] == '.' || cs2[k] == 'e' || cs2[k] == 'E') {
                has_dot_or_exp = true;
            }
        }
        delete cs2;
        if (has_dot_or_exp) { return toml_parse_float_token(tok, out); }
    }
    return toml_parse_int_token(tok, out);
}

// ---------------------------------------------------------------------------
// Composite values (declared before the dispatcher, mirroring finson:
// array/inline-table call the dispatcher, which is declared after them)
// ---------------------------------------------------------------------------

fun toml_parser_array(self: &TomlParser) <&TomlValue> {
    toml_parser_advance(self); // '['
    let v <&TomlValue> = toml_array();
    toml_skip_ws_comments(self);
    if (toml_parser_peek(self) == ']') {
        toml_parser_advance(self);
        return v;
    }
    while (true) {
        let item <&TomlValue> = toml_parser_value(self);
        if (self.failed) { toml_free(v); return null; }
        v.items.push(item);
        toml_skip_ws_comments(self);
        let c <char> = toml_parser_peek(self);
        if (c == ',') {
            toml_parser_advance(self);
            toml_skip_ws_comments(self);
            if (toml_parser_peek(self) == ']') {
                toml_parser_advance(self);
                break;
            }
        } else if (c == ']') {
            toml_parser_advance(self);
            break;
        } else {
            toml_parser_fail(self, "expected ',' or ']' in array");
            toml_free(v);
            return null;
        }
    }
    return v;
}

fun toml_parser_inline_table(self: &TomlParser) <&TomlValue> {
    toml_parser_advance(self); // '{'
    let v <&TomlValue> = toml_table();
    v.flags = 4; // inline tables cannot be extended from outside
    toml_skip_inline_ws(self);
    if (toml_parser_peek(self) == '}') {
        toml_parser_advance(self);
        return v;
    }
    while (true) {
        let keys <&Collection<string>> = toml_parse_key(self);
        if (self.failed) { toml_free(v); return null; }
        toml_skip_inline_ws(self);
        if (toml_parser_peek(self) != '=') {
            toml_parser_fail(self, "expected '=' in inline table");
            toml_free(v);
            return null;
        }
        toml_parser_advance(self);
        toml_skip_inline_ws(self);
        let val <&TomlValue> = toml_parser_value(self);
        if (self.failed) { toml_free(v); return null; }
        if (!toml_insert_dotted(v, keys, val)) {
            toml_parser_fail(self, "duplicate key in inline table");
            toml_free(val);
            toml_free(v);
            return null;
        }
        toml_skip_inline_ws(self);
        let c <char> = toml_parser_peek(self);
        if (c == ',') {
            toml_parser_advance(self);
            toml_skip_inline_ws(self);
        } else if (c == '}') {
            toml_parser_advance(self);
            break;
        } else {
            toml_parser_fail(self, "expected ',' or '}' in inline table");
            toml_free(v);
            return null;
        }
    }
    return v;
}

fun toml_parser_value(self: &TomlParser) <&TomlValue> {
    toml_skip_inline_ws(self);
    let c <char> = toml_parser_peek(self);
    if (c == '"') {
        let s? <string> = toml_parse_basic_string(self);
        if (self.failed) { return null; }
        return toml_str(s?);
    }
    if (c == '\'') {
        let s? <string> = toml_parse_literal_string(self);
        if (self.failed) { return null; }
        return toml_str(s?);
    }
    if (c == '[') { return toml_parser_array(self); }
    if (c == '{') { return toml_parser_inline_table(self); }
    if (c == cast<char>(0) || c == '\n') {
        toml_parser_fail(self, "expected a value");
        return null;
    }
    let tok <string> = toml_read_bare_token(self);
    tok = toml_extend_datetime(self, tok);
    if (len(tok) == 0) {
        toml_parser_fail(self, "expected a value");
        return null;
    }
    let v <&TomlValue> = toml_blank();
    if (!toml_parse_bare_token(tok, v)) {
        toml_parser_fail(self, "invalid value");
        toml_free(v);
        return null;
    }
    return v;
}

// Blank node (all fields empty) used as a scratch value by the bare-token
// parser, which fills in exactly one kind's fields.
fun toml_blank() <&TomlValue> {
    return new TomlValue{kind: -1, s: null, i: cast<long>(0),
                         f: cast<double>(0), b: false, flags: 0,
                         items: null, keys: null, vals: null};
}

// ---------------------------------------------------------------------------
// Document parsing
// ---------------------------------------------------------------------------

// Parse one `key = value` line into `current`. The caller has skipped
// leading blank lines/comments; the cursor is at the key.
fun toml_parse_keyval(self: &TomlParser, current: &TomlValue) <bool> {
    let keys <&Collection<string>> = toml_parse_key(self);
    if (self.failed) { return false; }
    toml_skip_inline_ws(self);
    if (toml_parser_peek(self) != '=') {
        toml_parser_fail(self, "expected '=' after key");
        return false;
    }
    toml_parser_advance(self);
    let val <&TomlValue> = toml_parser_value(self);
    if (self.failed) { return false; }
    if (!toml_insert_dotted(current, keys, val)) {
        toml_parser_fail(self, "duplicate key");
        toml_free(val);
        return false;
    }
    return toml_expect_eol(self);
}

// Parse a [table] or [[array-of-tables]] header. Returns the new current
// table, or null on failure (error already recorded).
fun toml_parse_header(self: &TomlParser, root: &TomlValue) <&TomlValue> {
    toml_parser_advance(self); // '['
    let is_aot <bool> = false;
    if (toml_parser_peek(self) == '[') {
        is_aot = true;
        toml_parser_advance(self);
    }
    let keys <&Collection<string>> = toml_parse_key(self);
    if (self.failed) { return null; }
    toml_skip_inline_ws(self);
    if (toml_parser_peek(self) != ']') {
        toml_parser_fail(self, "expected ']' after table header");
        return null;
    }
    toml_parser_advance(self);
    if (is_aot) {
        if (toml_parser_peek(self) != ']') {
            toml_parser_fail(self, "expected ']]' after array-of-tables header");
            return null;
        }
        toml_parser_advance(self);
    }
    if (!toml_expect_eol(self)) { return null; }
    let n <int> = keys.len();
    let parent <&TomlValue> = toml_nav_header(root, keys, n - 1);
    if (parent == null) {
        toml_parser_fail(self, "invalid table header path");
        return null;
    }
    let last <string> = keys.get(n - 1);
    let existing <&TomlValue> = toml_table_get(parent, last);
    if (is_aot) {
        let arr <&TomlValue> = existing;
        if (arr == null) {
            arr = toml_array();
            parent.keys.push(clone(last));
            parent.vals.push(arr);
        } else if (arr.kind != 4) {
            toml_parser_fail(self, "array-of-tables header redefines a non-array key");
            return null;
        }
        let elem <&TomlValue> = toml_table();
        arr.items.push(elem);
        return elem;
    }
    if (existing == null) {
        let tbl <&TomlValue> = toml_table();
        tbl.flags = 1; // defined by a header
        parent.keys.push(clone(last));
        parent.vals.push(tbl);
        return tbl;
    }
    if (existing.kind != 5) {
        toml_parser_fail(self, "table header redefines a value");
        return null;
    }
    if (existing.flags == 1) {
        toml_parser_fail(self, "table already defined");
        return null;
    }
    if (existing.flags == 2) {
        toml_parser_fail(self, "table already defined by a dotted key");
        return null;
    }
    if (existing.flags == 4) {
        toml_parser_fail(self, "table header redefines an inline table");
        return null;
    }
    existing.flags = 1;
    return existing;
}

#[export]
pub fun toml_parse(text: string) <TomlResult> {
    let root <&TomlValue> = toml_table();
    let p <&TomlParser> = new TomlParser{text: to_chars(text), n: len(text),
                                        pos: 0, line: 1, failed: false,
                                        err_line: 0, err_msg: ""};
    let current <&TomlValue> = root;
    while (p.pos < p.n) {
        let c <char> = p.text[p.pos];
        if (c == ' ' || c == '\t' || c == '\r') {
            p.pos = p.pos + 1;
        } else if (c == '\n') {
            toml_parser_advance(p);
        } else if (c == '#') {
            while (p.pos < p.n && p.text[p.pos] != '\n') { p.pos = p.pos + 1; }
        } else if (c == '[') {
            let next <&TomlValue> = toml_parse_header(p, root);
            if (p.failed) { break; }
            current = next;
        } else {
            if (!toml_parse_keyval(p, current)) { break; }
            // Consume the newline (toml_expect_eol stopped before it).
            if (p.pos < p.n && p.text[p.pos] == '\n') {
                toml_parser_advance(p);
            }
        }
    }
    if (p.failed) {
        let err <TomlError> = TomlError{line: p.err_line, message: p.err_msg};
        return TomlResult{ok: false, root: null, err: err};
    }
    return TomlResult{ok: true, root: root,
                      err: TomlError{line: 0, message: ""}};
}

#[export]
pub fun toml_parse_file(path: string) <TomlResult> {
    let raw? <string> = read_to_string(path);
    if (raw == null) {
        return TomlResult{ok: false, root: null,
                          err: TomlError{line: 0,
                                         message: "cannot read file"}};
    }
    let text <string> = raw?;
    return toml_parse(text);
}

// ---------------------------------------------------------------------------
// Getters by dotted path ("server.host", or quoted segments for keys
// that contain dots: "\"weird.key\".value").
// ---------------------------------------------------------------------------

#[export]
pub fun toml_get(root: &TomlValue, path: string) <&TomlValue> {
    if (root == null) { return null; }
    let p <&TomlParser> = new TomlParser{text: to_chars(path), n: len(path),
                                        pos: 0, line: 1, failed: false,
                                        err_line: 0, err_msg: ""};
    let keys <&Collection<string>> = toml_parse_key(p);
    if (p.failed) { return null; }
    let cur <&TomlValue> = root;
    let n <int> = keys.len();
    for (let i <int> = 0; i < n; i++) {
        if (cur == null || cur.kind != 5) { return null; }
        cur = toml_table_get(cur, keys.get(i));
    }
    return cur;
}

#[export]
pub fun toml_get_string(root: &TomlValue, path: string, default: string) <string> {
    let v <&TomlValue> = toml_get(root, path);
    // Datetimes are stored as raw text, so they read through the string
    // getter too (kind 6); anything else falls back to `default`.
    if (v == null || (v.kind != 0 && v.kind != 6)) { return default; }
    return v.s;
}

#[export]
pub fun toml_get_int(root: &TomlValue, path: string, default: long) <long> {
    let v <&TomlValue> = toml_get(root, path);
    if (v == null || v.kind != 1) { return default; }
    return v.i;
}

#[export]
pub fun toml_get_float(root: &TomlValue, path: string, default: double) <double> {
    let v <&TomlValue> = toml_get(root, path);
    if (v == null || v.kind != 2) { return default; }
    return v.f;
}

#[export]
pub fun toml_get_bool(root: &TomlValue, path: string, default: bool) <bool> {
    let v <&TomlValue> = toml_get(root, path);
    if (v == null || v.kind != 3) { return default; }
    return v.b;
}

// ---------------------------------------------------------------------------
// Encoding — canonical TOML output.
// ---------------------------------------------------------------------------

// A key is bare when it is non-empty and only [A-Za-z0-9_-].
fun toml_key_is_bare(key: string) <bool> {
    let n <int> = len(key);
    if (n == 0) { return false; }
    let cs <[char]> = to_chars(key);
    for (let i <int> = 0; i < n; i++) {
        if (!t_is_bare_key_char(cs[i])) { delete cs; return false; }
    }
    delete cs;
    return true;
}

// Escape one string as a basic "..." literal (also used for keys).
fun toml_encode_basic_string(s: string) <string> {
    let buf <&TomlBuf> = toml_buf_new();
    toml_buf_push(buf, '"');
    let cs <[char]> = to_chars(s);
    let n <int> = len(s);
    for (let i <int> = 0; i < n; i++) {
        let c <char> = cs[i];
        if (c == '"') { toml_buf_push(buf, '\\'); toml_buf_push(buf, '"'); }
        else if (c == '\\') { toml_buf_push(buf, '\\'); toml_buf_push(buf, '\\'); }
        else if (c == cast<char>(8)) { toml_buf_push(buf, '\\'); toml_buf_push(buf, 'b'); }
        else if (c == cast<char>(9)) { toml_buf_push(buf, '\\'); toml_buf_push(buf, 't'); }
        else if (c == cast<char>(10)) { toml_buf_push(buf, '\\'); toml_buf_push(buf, 'n'); }
        else if (c == cast<char>(12)) { toml_buf_push(buf, '\\'); toml_buf_push(buf, 'f'); }
        else if (c == cast<char>(13)) { toml_buf_push(buf, '\\'); toml_buf_push(buf, 'r'); }
        else if (cast<int>(c) < 32 || cast<int>(c) == 127) {
            toml_buf_push(buf, '\\');
            toml_buf_push(buf, 'u');
            toml_buf_push(buf, '0');
            toml_buf_push(buf, '0');
            toml_buf_push(buf, t_hex_digit(cast<int>(c) / 16));
            toml_buf_push(buf, t_hex_digit(cast<int>(c) % 16));
        } else {
            toml_buf_push(buf, c);
        }
    }
    delete cs;
    toml_buf_push(buf, '"');
    let out <string> = toml_buf_to_string(buf);
    toml_buf_free(buf);
    return out;
}

// Blank-line separator between sections, but never at the very start.
fun toml_buf_push_sep(buf: &TomlBuf) <noret> {
    if (buf.len > 0) { toml_buf_push(buf, '\n'); }
}
fun toml_encode_key(key: string) <string> {
    if (toml_key_is_bare(key)) { return clone(key); }
    return toml_encode_basic_string(key);
}

fun toml_encode_float(f: double) <string> {
    if (f != f) { return "nan"; }
    let inf <double> = cast<double>(1) / cast<double>(0);
    if (f == inf) { return "inf"; }
    if (f == cast<double>(0) - inf) { return "-inf"; }
    return number2str_float(f);
}

fun toml_encode_value(v: &TomlValue) <string> {
    if (v.kind == 0) { return toml_encode_basic_string(v.s); }
    if (v.kind == 1) { return toml_long_str(v.i); }
    if (v.kind == 2) { return toml_encode_float(v.f); }
    if (v.kind == 3) {
        if (v.b) { return "true"; }
        return "false";
    }
    if (v.kind == 6) { return clone(v.s); }
    if (v.kind == 4) {
        let buf <&TomlBuf> = toml_buf_new();
        toml_buf_push(buf, '[');
        let n <int> = v.items.len();
        for (let i <int> = 0; i < n; i++) {
            if (i > 0) { toml_buf_append_str(buf, ", "); }
            toml_buf_append_str(buf, toml_encode_value(v.items.get(i)));
        }
        toml_buf_push(buf, ']');
        let out <string> = toml_buf_to_string(buf);
        toml_buf_free(buf);
        return out;
    }
    if (v.kind == 5) {
        // Inline table form: { k = v, ... }.
        let buf <&TomlBuf> = toml_buf_new();
        toml_buf_push(buf, '{');
        let n <int> = v.keys.len();
        for (let i <int> = 0; i < n; i++) {
            if (i > 0) { toml_buf_append_str(buf, ", "); }
            toml_buf_append_str(buf, toml_encode_key(v.keys.get(i)));
            toml_buf_append_str(buf, " = ");
            toml_buf_append_str(buf, toml_encode_value(v.vals.get(i)));
        }
        toml_buf_push(buf, '}');
        let out <string> = toml_buf_to_string(buf);
        toml_buf_free(buf);
        return out;
    }
    return "";
}

// Count a table's entries that encode as direct keyvals (scalars and
// plain arrays). Sub-tables and arrays-of-tables encode as sections.
fun toml_count_direct_entries(tbl: &TomlValue) <int> {
    let count <int> = 0;
    let n <int> = tbl.keys.len();
    for (let i <int> = 0; i < n; i++) {
        let child <&TomlValue> = tbl.vals.get(i);
        if (child.kind == 5) { continue; }
        if (child.kind == 4 && child.items.len() > 0
            && child.items.get(0).kind == 5) { continue; }
        count = count + 1;
    }
    return count;
}
// Emit one table's scalar/array entries, then recurse into sub-tables
// under [prefix] headers. `prefix` is "" for the document root.
fun toml_encode_table_into(buf: &TomlBuf, tbl: &TomlValue, prefix: string) <noret> {
    let n <int> = tbl.keys.len();
    for (let i <int> = 0; i < n; i++) {
        let child <&TomlValue> = tbl.vals.get(i);
        if (child.kind == 5) { continue; }
        if (child.kind == 4 && child.items.len() > 0
            && child.items.get(0).kind == 5) { continue; }
        toml_buf_append_str(buf, toml_encode_key(tbl.keys.get(i)));
        toml_buf_append_str(buf, " = ");
        toml_buf_append_str(buf, toml_encode_value(child));
        toml_buf_push(buf, '\n');
    }
    for (let i <int> = 0; i < n; i++) {
        let key <string> = tbl.keys.get(i);
        let child <&TomlValue> = tbl.vals.get(i);
        let child_path <string> = "";
        if (len(prefix) == 0) {
            child_path = toml_encode_key(key);
        } else {
            child_path = concat(concat(prefix, "."), toml_encode_key(key));
        }
        if (child.kind == 5) {
            // A table with only sub-tables (e.g. [profile] implied by
            // [profile.release]) needs no header of its own; an empty
            // table keeps its header so it survives the round-trip.
            if (toml_count_direct_entries(child) == 0
                && child.keys.len() > 0) {
                toml_encode_table_into(buf, child, child_path);
            } else {
                toml_buf_push_sep(buf);
                toml_buf_push(buf, '[');
                toml_buf_append_str(buf, child_path);
                toml_buf_push(buf, ']');
                toml_buf_push(buf, '\n');
                toml_encode_table_into(buf, child, child_path);
            }
        } else if (child.kind == 4 && child.items.len() > 0
            && child.items.get(0).kind == 5) {
            let m <int> = child.items.len();
            for (let j <int> = 0; j < m; j++) {
                toml_buf_push_sep(buf);
                toml_buf_push(buf, '[');
                toml_buf_push(buf, '[');
                toml_buf_append_str(buf, child_path);
                toml_buf_push(buf, ']');
                toml_buf_push(buf, ']');
                toml_buf_push(buf, '\n');
                toml_encode_table_into(buf, child.items.get(j), child_path);
            }
        }
    }
}

#[export]
pub fun toml_encode(root: &TomlValue) <string> {
    if (root == null || root.kind != 5) { return ""; }
    let buf <&TomlBuf> = toml_buf_new();
    toml_encode_table_into(buf, root, "");
    let out <string> = toml_buf_to_string(buf);
    toml_buf_free(buf);
    return out;
}

// ---------------------------------------------------------------------------
// Memory — release a parsed/built tree (mirrors finson's json_free).
// ---------------------------------------------------------------------------

#[export]
pub fun toml_free(v: &TomlValue) <noret> {
    if (v == null) { return; }
    if (v.kind == 0 || v.kind == 6) {
        free_str(v.s);
    }
    if (v.kind == 4) {
        let n <int> = v.items.len();
        for (let i <int> = 0; i < n; i++) {
            toml_free(v.items.get(i));
        }
        delete v.items;
    }
    if (v.kind == 5) {
        let n <int> = v.keys.len();
        for (let i <int> = 0; i < n; i++) {
            free_str(v.keys.get(i));
            toml_free(v.vals.get(i));
        }
        delete v.keys;
        delete v.vals;
    }
    delete v;
}

#[export]
pub fun toml_free_result(r: &TomlResult) <noret> {
    if (r.ok) {
        toml_free(r.root);
    } else {
        free_str(r.err.message);
    }
}

} // namespace fin
